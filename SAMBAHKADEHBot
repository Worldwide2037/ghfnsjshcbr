def call(method, data=None):
    response = requests.post(
        f"{API}/{method}",
        json=data or {},
        timeout=35
    )

    try:
        result = response.json()
    except Exception:
        raise RuntimeError(
            f"پاسخ نامعتبر سرور: {response.text[:300]}"
        )

    if not response.ok or not result.get("ok", False):
        raise RuntimeError(
            f"خطای API در {method}: {result}"
        )

    return result

