def news_clean(value):
    value = html.unescape(str(value or ""))
    value = re.sub(r"<[^>]+>", " ", value)
    return re.sub(r"\s+", " ", value).strip()

def news_load_state():
    global NEWS_QUEUE, NEWS_SEEN
    try:
        data = json.loads(NEWS_STATE_FILE.read_text(encoding="utf-8"))
        NEWS_QUEUE = data.get("queue", [])[-500:]
        NEWS_SEEN = set(data.get("seen", [])[-10000:])
    except Exception:
        NEWS_QUEUE = []
        NEWS_SEEN = set()

def news_save_state():
    try:
        data = {
            "queue": NEWS_QUEUE[-500:],
            "seen": list(NEWS_SEEN)[-10000:]
        }
        temp = NEWS_STATE_FILE.with_suffix(".tmp")
        temp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
        temp.replace(NEWS_STATE_FILE)
    except Exception as e:
        print("STATE ERROR:", e)

def news_read_feed(source, url):
    import requests

    response = requests.get(
        url,
        timeout=12,
        headers={"User-Agent": "Mozilla/5.0"}
    )
    response.raise_for_status()

    root = ET.fromstring(response.content)
    entries = root.findall(".//item")

    if not entries:
        entries = root.findall(
            ".//{http://www.w3.org/2005/Atom}entry"
        )

    result = []

    for entry in entries[:60]:
        title = news_clean(
            entry.findtext("title") or
            entry.findtext("{http://www.w3.org/2005/Atom}title")
        )

        link = news_clean(entry.findtext("link") or "")

        if not link:
            node = entry.find(
                "{http://www.w3.org/2005/Atom}link"
            )
            if node is not None:
                link = node.attrib.get("href", "")

        description = news_clean(
            entry.findtext("description") or
            entry.findtext("{http://www.w3.org/2005/Atom}summary") or ""
        )

        if not title or not link:
            continue

        if not re.search(r"[\u0600-\u06FF]", title):
            continue

        key = hashlib.sha256(
            link.encode("utf-8")
        ).hexdigest()

        result.append({
            "title": title[:250],
            "description": description[:450],
            "link": link,
            "source": source,
            "key": key
        })

    return result


def news_make_text(item):
    title = item.get("title", "").strip()
    desc = item.get("description", "").strip()

    # حذف پیشوند شهر و نام خبرگزاری از ابتدای توضیحات
    desc = re.sub(
        r"^[^،\n]{1,45}?\s*[-–—]\s*(?:(?:ایرنا|ایسنا|مهر|فارس|"
        r"ایسنا|خبرگزاری[^-–—]*)\s*[-–—]\s*)?",
        "",
        desc
    ).strip()

    # حذف لینک‌ها و عبارت‌های منبع از توضیحات
    desc = re.sub(r"https?://\S+", "", desc)
    desc = re.sub(r"منبع\s*:\s*[^\n]+", "", desc)
    desc = desc.strip()

    text = (
        title if (is_sport_news(item) or is_breaking_news(item) or is_education_news(item))
        else "📰 " + title
    )

    if desc and desc != title:
        text += "\n\n" + desc

    text += "\n\nرویداد های جهان\n@WORLDEVENTS"
    return text

def check_news_schedule():
    global NEWS_LAST_FETCH, NEWS_LAST_PUBLISH

    now = time.time()

    # دریافت خبرها هر ۶۰ ثانیه
    if now - NEWS_LAST_FETCH >= NEWS_FETCH_INTERVAL:
        NEWS_LAST_FETCH = now

        fresh = []

        for source, url in NEWS_SOURCES:
            try:
                fresh.extend(
                    news_read_feed(source, url)
                )
            except Exception as e:
                print("FEED ERROR:", source, str(e)[:120])

        queued = {x["key"] for x in NEWS_QUEUE}

        for item in fresh:
            if item["key"] not in NEWS_SEEN and item["key"] not in queued:
                NEWS_QUEUE.append(item)
                queued.add(item["key"])

        news_save_state()
        print("NEWS QUEUE:", len(NEWS_QUEUE))

    # انتشار حداکثر یک خبر در هر ۱۰ ثانیه
    if NEWS_QUEUE and now - NEWS_LAST_PUBLISH >= NEWS_PUBLISH_INTERVAL:
        item = NEWS_QUEUE[0]

        try:
            publish_channel_news(news_make_text(item), is_breaking_news(item), is_sport_news(item), is_education_news(item))

            NEWS_QUEUE.pop(0)
            NEWS_SEEN.add(item["key"])
            NEWS_LAST_PUBLISH = now

            news_save_state()

            print("PUBLISHED:", item["title"][:80])

        except Exception as e:
            print("PUBLISH ERROR:", str(e)[:150])

news_load_state()
